CHAT2DB_TAG=local
CHAT2DB_PORT=10824
CHAT2DB_DATA_DIR=$HOME/.chat2db-docker
CHAT2DB_GATEWAY_PORT=18080
CHAT2DB_GATEWAY_BASE_URL=http://chat2db-gateway:18080
CHAT2DB_GATEWAY_MODEL_BASE_URL=http://chat2db-gateway:18080
GATEWAY_UPSTREAM_BASE_URL=http://test.sqlgpt.cn/gateway
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_KNOWLEDGE_COLLECTION=chat2db_knowledge
MILVUS_SCHEMA_COLLECTION=chat2db_schema
MILVUS_METRIC_TYPE=COSINE
MILVUS_TOP_K=5
MILVUS_EXPOSED_PORT=19530
MILVUS_HTTP_EXPOSED_PORT=9091
MILVUS_DATA_DIR=$HOME/.chat2db-milvus/milvus
MILVUS_ETCD_DATA_DIR=$HOME/.chat2db-milvus/etcd
MILVUS_MINIO_DATA_DIR=$HOME/.chat2db-milvus/minio
MILVUS_MINIO_ROOT_USER=minioadmin
MILVUS_MINIO_ROOT_PASSWORD=minioadmin
